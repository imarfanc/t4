{
  "name": "link-skills",
  "version": "1.0.0",
  "exports": "./link-skills.ts",
  "tasks": {
    "link": "deno run --allow-read --allow-write --allow-env link-skills.ts",
    "link-all": "deno run --allow-read --allow-write --allow-env link-skills.ts --all",
    "check": "deno run --allow-read --allow-write --allow-env link-skills.ts --dry-run",
    "typecheck": "deno check link-skills.ts"
  },
  "imports": {
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@cliffy/table": "jsr:@cliffy/table@^1.2.1",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0"
  },
  "fmt": {
    "lineWidth": 100
  }
}
