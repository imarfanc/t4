{
  "name": "repo-template",
  "private": true,
  "type": "module",
  "scripts": {
    "choose": "node _other/scripts/vp-run-chooser/choose.ts",
    "check": "vp check && node _other/scripts/template-check/template-check.ts",
    "skills": "node _other/scripts/link-skills/link-skills.ts",
    "skills:all": "node _other/scripts/link-skills/link-skills.ts --all",
    "skills:check": "node _other/scripts/link-skills/link-skills.ts --dry-run",
    "skills:prune": "node _other/scripts/link-skills/link-skills.ts --prune",
    "skills:links": "bash _other/scripts/link-skills/links.sh",
    "skills:config": "sh -c '${EDITOR:-vi} _other/scripts/link-skills/data/skills.yaml'",
    "template:init": "node _other/scripts/template-init/template-init.ts",
    "template:check": "node _other/scripts/template-check/template-check.ts",
    "template:reset": "node _other/scripts/template-reset/template-reset.ts",
    "template:reset:apply": "node _other/scripts/template-reset/template-reset.ts --apply",
    "template:config": "sh -c '${EDITOR:-vi} _other/scripts/template-reset/data/template.yaml'"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.4",
    "@iconify-json/mdi": "1.2.3",
    "@iconify/utils": "3.1.1",
    "@inquirer/prompts": "^7.5.3",
    "picocolors": "^1.1.1",
    "vite-plus": "^0.2.6",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.20.0"
}
